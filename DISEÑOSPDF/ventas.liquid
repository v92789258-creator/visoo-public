<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Reporte Diario Óptica</title>

<style>
*{box-sizing:border-box}
body{margin:0;background:white;font-family:Arial, Helvetica, sans-serif;color:#000;}
.reporte{width:794px;min-height:1123px;margin:auto;padding:20px 24px;font-size:10px;}
.header{display:grid;grid-template-columns:90px 1fr 230px;gap:14px;align-items:start;}
.logo{width:82px;height:82px;border-radius:50%;background:#222;color:white;border:4px solid #e6b400;display:flex;align-items:center;justify-content:center;text-align:center;font-size:15px;font-weight:bold;overflow:hidden;}
.empresa{text-align:center;}
.empresa h1{margin:0;font-size:17px;}
.empresa h2{margin:2px 0 5px;font-size:11px;}
.empresa p{margin:2px 0;line-height:1.25;}
.doc-box{border:1.5px solid #000;border-radius:8px;text-align:center;overflow:hidden;}
.doc-box div{border-bottom:1px solid #000;padding:8px 5px;font-weight:bold;}
.doc-box div:last-child{border-bottom:0;}
.doc-title{font-size:16px;}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:18px;}
.info-line{display:grid;grid-template-columns:125px 1fr;margin-bottom:5px;}
.resumen{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px;}
.card{border:1px solid #000;border-radius:6px;padding:8px;text-align:center;}
.card b{display:block;font-size:14px;margin-top:4px;}
.section-title{margin-top:16px;margin-bottom:4px;font-weight:bold;}
table{width:100%;border-collapse:collapse;}
th,td{border:1px solid #000;padding:4px;vertical-align:top;}
th{background:#111;color:white;font-size:9px;text-align:center;}
.center{text-align:center}
.right{text-align:right}
.estado{font-weight:bold;text-align:center;}
.bottom{display:grid;grid-template-columns:1fr 260px;gap:20px;margin-top:15px;}
.obs{border:1px solid #2c8b35;border-radius:5px;min-height:70px;padding:7px;line-height:1.4;}
.totals td{border:0;padding:4px;font-size:11px;}
.totals .label{text-align:right;font-weight:bold;}
.totals .money{text-align:right;width:90px;}
.footer{margin-top:30px;display:grid;grid-template-columns:170px 1fr;gap:20px;align-items:end;}
.qr{width:110px;height:110px;background:repeating-linear-gradient(45deg,#000 0 5px,#fff 5px 10px);}
.firma{border:1.5px solid #000;border-radius:8px;height:90px;padding-top:40px;}
.firma-line{border-top:1px dashed #555;margin:0 8px;padding-top:4px;text-align:center;}
.legal{border-top:1px solid #000;margin-top:20px;padding-top:6px;font-size:9px;text-align:center;}
@media print{@page{size:A4;margin:0;}.reporte{margin:0;}}
</style>
</head>
<body>
<div class="reporte">
  <div class="header">
    <div class="logo">
      {% if logo_data_uri %}
      <img src="{{ logo_data_uri }}" style="width:100%;height:100%;object-fit:cover;" alt="Logo">
      {% else %}
      TU<br>LOGO<br>AQUÍ
      {% endif %}
    </div>

    <div class="empresa">
      <h1>{{ optica_name }}</h1>
      <h2>REPORTE DIARIO DE OPERACIONES</h2>
      <p><b>Dirección:</b> {{ company_address }}</p>
      <p><b>Sucursal:</b> {{ branch_name }}</p>
      <p><b>Teléfono:</b> {{ phone }} | {{ email }}</p>
    </div>

    <div class="doc-box">
      <div>R.U.C. {{ company_ruc }}</div>
      <div class="doc-title">REPORTE DIARIO</div>
      <div>CONTRATOS Y VENTAS</div>
      <div>{{ report_code }}</div>
    </div>
  </div>

  <div class="info-grid">
    <div>
      <div class="info-line"><b>FECHA:</b><span>{{ report_date }}</span></div>
      <div class="info-line"><b>CAJERO:</b><span>{{ generated_by }}</span></div>
      <div class="info-line"><b>SUCURSAL:</b><span>{{ branch_name }}</span></div>
    </div>
    <div>
      <div class="info-line"><b>HORA:</b><span>{{ generated_hour }}</span></div>
      <div class="info-line"><b>PERIODO:</b><span>{{ report_period }}</span></div>
      <div class="info-line"><b>MONEDA:</b><span>SOLES</span></div>
    </div>
  </div>

  <div class="resumen">
    <div class="card">Contratos ópticos<b>{{ contratos_count }}</b></div>
    <div class="card">Ventas sueltas<b>{{ ventas_sueltas_count }}</b></div>
    <div class="card">Cobrado hoy<b>S/ {{ cobrado_total }}</b></div>
    <div class="card">Debe total<b>S/ {{ pendiente_total }}</b></div>
  </div>

  <div class="section-title">Contratos ópticos del día</div>
  <table>
    <thead>
      <tr>
        <th style="width:30px">N°</th>
        <th style="width:90px">CONTRATO</th>
        <th>CLIENTE</th>
        <th style="width:80px">MEDIDA</th>
        <th style="width:75px">VENDEDOR</th>
        <th style="width:65px">TOTAL</th>
        <th style="width:65px">A CUENTA</th>
        <th style="width:65px">DEBE</th>
        <th style="width:75px">ESTADO</th>
      </tr>
    </thead>
    <tbody>
      {% for item in contratos %}
      <tr>
        <td class="center">{{ item.index }}</td>
        <td class="center">{{ item.contrato }}</td>
        <td>{{ item.cliente }}</td>
        <td class="center">{{ item.medida }}</td>
        <td class="center">{{ item.vendedor }}</td>
        <td class="right">{{ item.total }}</td>
        <td class="right">{{ item.a_cuenta }}</td>
        <td class="right">{{ item.debe }}</td>
        <td class="estado">{{ item.estado }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Ventas sueltas del día</div>
  <table>
    <thead>
      <tr>
        <th style="width:30px">N°</th>
        <th style="width:90px">VENTA</th>
        <th>PRODUCTO / DETALLE</th>
        <th style="width:80px">CLIENTE</th>
        <th style="width:75px">VENDEDOR</th>
        <th style="width:75px">PAGO</th>
        <th style="width:70px">TOTAL</th>
      </tr>
    </thead>
    <tbody>
      {% for item in ventas_sueltas %}
      <tr>
        <td class="center">{{ item.index }}</td>
        <td class="center">{{ item.venta }}</td>
        <td>{{ item.detalle }}</td>
        <td class="center">{{ item.cliente }}</td>
        <td class="center">{{ item.vendedor }}</td>
        <td class="center">{{ item.pago }}</td>
        <td class="right">{{ item.total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Comisiones por vendedor</div>
  <table>
    <thead>
      <tr>
        <th>VENDEDOR</th>
        <th style="width:110px">CONTRATOS</th>
        <th style="width:110px">VENTAS SUELTAS</th>
        <th style="width:110px">TOTAL VENDIDO</th>
        <th style="width:110px">COMISIÓN</th>
      </tr>
    </thead>
    <tbody>
      {% for item in comisiones %}
      <tr>
        <td>{{ item.vendedor }}</td>
        <td class="center">{{ item.contratos }}</td>
        <td class="center">{{ item.ventas_sueltas }}</td>
        <td class="right">{{ item.total_vendido }}</td>
        <td class="right">{{ item.comision }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="bottom">
    <div class="obs">
      <b>Observaciones:</b><br>
      {{ observations }}
    </div>
    <div>
      <table class="totals">
        <tr><td class="label">TOTAL CONTRATOS</td><td class="money">S/ {{ total_contratos }}</td></tr>
        <tr><td class="label">TOTAL VENTAS SUELTAS</td><td class="money">S/ {{ total_ventas_sueltas }}</td></tr>
        <tr><td class="label">A CUENTA COBRADO</td><td class="money">S/ {{ total_abonos }}</td></tr>
        <tr><td class="label">DEBE CONTRATOS</td><td class="money">S/ {{ pendiente_total }}</td></tr>
        <tr><td class="label">COBRADO HOY</td><td class="money"><b>S/ {{ cobrado_total }}</b></td></tr>
        <tr><td class="label">COMISIONES</td><td class="money">S/ {{ total_comisiones }}</td></tr>
      </table>
    </div>
  </div>

  <div class="footer">
    <div>
      <div class="qr">
        {% if qr_data_uri %}
        <img src="{{ qr_data_uri }}" style="width:110px;height:110px;display:block;" alt="QR">
        {% endif %}
      </div>
      <div style="font-size:9px;margin-top:6px;">
        Representación impresa del <b>REPORTE DIARIO DE OPERACIONES</b><br>
        Generado por sistema VISO
      </div>
    </div>
    <div class="firma">
      <div class="firma-line">Firma / cierre de caja del responsable</div>
    </div>
  </div>

  <div class="legal">
    Documento interno de control administrativo. No reemplaza boleta, factura ni comprobante electrónico SUNAT.
  </div>
</div>
</body>
</html>
